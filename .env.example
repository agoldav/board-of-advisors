# Board of Advisors — environment template. Copy to .env and fill in.
# Secrets are read from env vars only (docs/06 Security Architecture).

# --- Anthropic (Claude) ---
# Recommended: a dedicated key in its own workspace so this app's spend is
# isolated and cannot drain other apps sharing the account (docs/06 LLM Layer).
ANTHROPIC_API_KEY=

# Provider is a config value; the abstraction layer supports swapping later.
# Use `anthropic` when ANTHROPIC_API_KEY is set. Use `mock` (or leave the key
# empty) to run the golden path offline.
LLM_PROVIDER=anthropic

# Optional: reuse a known owner UUID across restarts (created by POST /api/session).
# OWNER_ID=

# --- PostgreSQL ---
DATABASE_URL=postgres://localhost:5432/board_of_advisors

# --- Scheduler / sweep endpoint (D: commitments daily sweep) ---
# Shared secret checked by /api/sweep; also stored in GitHub Secrets.
SWEEP_SHARED_SECRET=

# Where overdue-commitment emails go (POC: single owner; no email column yet).
OWNER_NOTIFY_EMAIL=

# Port for the minimal sweep HTTP server (`npm run sweep-server`).
PORT=8787

# --- Spend tracking (D-032) — visibility, not a hard cutoff ---
# Monthly budget in USD used only for the 90% alert. The app never hard-stops.
MONTHLY_BUDGET_USD=30
