{
  "name": "board-of-advisors",
  "version": "0.1.0",
  "private": true,
  "description": "AI board of advisors for small business owners — profile, model router, commitments, advisors, document ingestion.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node --input-type=commonjs -e \"require('fs').cpSync('src/advisors/configs','dist/advisors/configs',{recursive:true})\"",
    "start": "node dist/api/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sweep-server": "tsx --env-file=.env src/api/server.ts",
    "dev:api": "tsx --env-file=.env src/api/server.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },

  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
